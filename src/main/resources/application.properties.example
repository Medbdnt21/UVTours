# Plantilla de configuración. Cópiala antes de arrancar el backend:
#
#   cp src/main/resources/application.properties.example src/main/resources/application.properties
#
# y sustituye los valores <...> por los tuyos. Este fichero SÍ se versiona;
# application.properties (con tus credenciales reales) no.

spring.application.name=UvTours

spring.datasource.url=jdbc:mysql://localhost:3306/uvtours_db
spring.datasource.username=<TU_USUARIO_MYSQL>
spring.datasource.password=<TU_PASSWORD_MYSQL>

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

spring.jpa.properties.hibernate.format_sql=true

spring.task.scheduling.enabled=true

# Firma del JWT (HS256). Debe tener >= 32 bytes. Genera la tuya, por ejemplo con:
#   openssl rand -base64 48
jwt.secret=<CLAVE_JWT_DE_AL_MENOS_32_BYTES>
jwt.expiration-ms=86400000

# Cuenta de administrador sembrada al arrancar (solo se crea si no existe)
app.admin.email=admin@uvtours.com
app.admin.password=<TU_PASSWORD_ADMIN>
app.admin.nombre=Administrador

# Autenticación OAuth2 (login con proveedor externo), desactivada por defecto.
# Para activarla: app.oauth2.enabled=true y configurar una registration, ej. GitHub:
#   spring.security.oauth2.client.registration.github.client-id=<TU_CLIENT_ID>
#   spring.security.oauth2.client.registration.github.client-secret=<TU_CLIENT_SECRET>
#   spring.security.oauth2.client.registration.github.scope=user:email
# El flujo es: GET /oauth2/authorization/github -> proveedor -> callback ->
# OAuth2LoginSuccessHandler genera nuestro JWT y lo devuelve (JSON) o redirige a:
#   app.oauth2.redirect-uri=http://localhost:5173/oauth2/callback
app.oauth2.enabled=false
